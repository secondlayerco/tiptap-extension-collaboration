{
  "name": "tiptap-extension-collaboration",
  "description": "collaboration extension for tiptap",
  "version": "1.3.0-napkin",
  "type": "module",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "3.19.0",
    "@tiptap/pm": "3.19.0",
    "@tiptap/y-tiptap": "3.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tiptap/core": "3.19.0",
    "@tiptap/pm": "3.19.0",
    "@tiptap/y-tiptap": "3.0.2",
    "yjs": "13.6.29"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/secondlayerco/tiptap-extension-collaboration"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
